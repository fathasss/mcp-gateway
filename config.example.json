{
  "version": "1.0.0",
  "servers": {
    "github": {
      "id": "github",
      "name": "github",
      "description": "GitHub repositories, issues, and pull requests",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "enabled": true,
      "shortcuts": []
    },
    "local-http": {
      "id": "local-http",
      "name": "local-http",
      "description": "Example local StreamableHTTP MCP server",
      "transport": "http",
      "url": "http://localhost:8080/mcp",
      "headers": {
        "Authorization": "Bearer ${LOCAL_API_TOKEN}"
      },
      "enabled": false,
      "shortcuts": []
    }
  }
}
